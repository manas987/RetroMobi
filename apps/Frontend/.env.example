# Port this dev/prod server listens on.
PORT=5180

# Copy to .env. Only BUN_PUBLIC_* vars are inlined into the browser bundle
# (see bunfig.toml and build.ts). Maps require the public Mapbox token below.
# Google sign-in is optional when its client id is absent.

# Same-origin proxy target — see src/index.ts. Defaults to localhost:3201.
BACKEND_URL=http://localhost:3201

# Public Mapbox browser token (pk.), restricted to your site's URLs in Mapbox.
# This value is visible in the browser bundle. Never use a secret sk. token.
BUN_PUBLIC_MAPBOX_TOKEN=

# --- Google sign-in (optional) ----------------------------------------------
# The same OAuth client id the backend verifies ID tokens against
# (GOOGLE_CLIENT_ID in the backend's .env). A client id is public by design —
# it identifies the app and is not a secret — which is why it is safe to
# inline into the browser bundle.
#
# Leave it unset and the "Continue with Google" button is not rendered at all;
# signup falls back to the email-OTP path. Set it and Google's verified email
# replaces that step entirely.
# BUN_PUBLIC_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# --- SMS sign-in fallback, Firebase Phone Auth (optional) --------------------
# Sign-in codes go out on WhatsApp from the backend. When WhatsApp can't deliver
# (or the rider taps "Send by SMS instead"), the browser asks Firebase to text
# the code, then hands Firebase's ID token to the backend. This web config is
# public by design: it names the Firebase project, it isn't a credential. What
# protects it is the project's authorized-domains list and its SMS region
# policy (India only), both set in the Firebase console.
#
# Leave any of the four unset and SMS is not offered anywhere: no link, no
# automatic fallback. The project id must equal the backend's FIREBASE_PROJECT_ID.
# BUN_PUBLIC_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
# BUN_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# BUN_PUBLIC_FIREBASE_PROJECT_ID=your-project
# BUN_PUBLIC_FIREBASE_APP_ID=replace-with-your-firebase-web-app-id
