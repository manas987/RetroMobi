# Copy to .env and fill in. Values here are placeholders, never real credentials.
#
# Vars marked REQUIRED are checked by src/lib/config.ts and the server refuses to
# start without them -- they are the ones whose absence produces silently wrong
# money or documents rather than a loud error.
#
# Every third-party provider (Twilio, Resend, Cashfree, flespi, R2) falls back to
# a console.log + a fake-but-well-typed success response when its vars below are
# left blank -- look for "[dev-fallback]" in server logs. This means the WHOLE
# app (signup, booking, payment, payout, KYC, tracking, uploads) runs end-to-end
# locally with zero vendor credentials, which is the point: fill in a provider's
# vars and it switches to the real API with no code change, nothing else to flip.
#
# envDrift.test.ts fails if the code reads a var that is missing from this file.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://retromobi:retromobi@localhost:5434/retromobi          # REQUIRED
TEST_DATABASE_URL=postgres://retromobi:retromobi@localhost:5434/retromobi_test
AUTH_ACCESS_TOKEN_SECRET=change-me-in-prod                                     # REQUIRED
PORT=3201

# Host port of the local Postgres container (docker-compose.yml in this folder
# reads it too). 5434 so it never clashes with another project's 5432/5433;
# keep DATABASE_URL / TEST_DATABASE_URL on the same port.
DB_PORT=5434
# Enable only when the origin is reachable exclusively through Cloudflare with
# Add visitor location headers enabled. Stores approximate city/country at sign-in.
TRUST_CF_LOCATION_HEADERS=false

# --- Money and tax ----------------------------------------------------------
# Set these with your accountant. The three percentages are REQUIRED: each has a
# code-level fallback that would otherwise price bookings at a rate nobody chose.
# Prices are TAX-INCLUSIVE -- GST is extracted from the listed price, not added.
GST_RATE=18
PLATFORM_FEE_PCT=10
PAYOUT_UPFRONT_PCT=10
# RetroMobi's own GSTIN, printed on every PLATFORM fee invoice. OPTIONAL: leave it
# blank until you are GST-registered and no PLATFORM invoice is issued (same rule as
# an unregistered shop). If you do set it, it must be a real 15-character GSTIN --
# a placeholder will not boot, because a wrong GSTIN on a tax invoice is worse than
# a blank one.
PLATFORM_GSTIN=

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# Sign-in codes and phone notifications. Blank = dev-fallback: the message is
# logged as "[dev-fallback]" instead of sent, so local dev needs no Meta account.
# The first three are REQUIRED in production, because there that fallback would
# mean nobody can sign in. See docs/deployment.md for the Meta setup.
# A permanent System User token, not the 24-hour one from the API Setup page.
WHATSAPP_TOKEN=replace-with-your-whatsapp-system-user-token
# The sender number's id from WhatsApp Manager (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-whatsapp-phone-number-id
# Name of the approved Authentication template (copy-code button).
WHATSAPP_OTP_TEMPLATE=retromobi_otp
# The language every template (OTP and notifications) was approved in. A send in
# a language the template wasn't created in fails. Defaults to en_US.
WHATSAPP_OTP_LANGUAGE=en_US
# Only if the OTP template has a second body slot after the code (max 15 chars),
# e.g. "login". Leave blank for a template whose body is just the code.
WHATSAPP_OTP_TEXT=

# --- Firebase phone auth (SMS fallback, optional) ---------------------------
# Used only to verify the ID token the browser gets after Firebase texts the
# code -- no service account needed, just the project id the token is issued
# for. Must match the frontend's BUN_PUBLIC_FIREBASE_PROJECT_ID. Leave both
# blank and the "Send by SMS" fallback is simply not offered.
FIREBASE_PROJECT_ID=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_ADDRESS=noreply@example.com

# --- Public origin ----------------------------------------------------------
# Where the customer-facing app actually lives. Cashfree's return_url (where a
# paying customer lands) and notify_url (the webhook registered on the order)
# are built from it, so without it a customer who pays is stranded on the
# gateway's page. REQUIRED in production, and must be https there -- Cashfree
# rejects a non-https notify_url, so on http it is simply omitted and the
# webhook has to be configured in the dashboard instead.
PUBLIC_APP_BASE_URL=http://localhost:5180

# --- Payments and KYC (Cashfree) --------------------------------------------
# One vendor for both: PG Orders for payments, Secure ID for DL + DigiLocker.
# The full Cashfree contract -- every endpoint, header, field and status value,
# fetched from the vendor docs -- is in docs/payments.md.
CASHFREE_CLIENT_ID=replace-with-your-cashfree-client-id
CASHFREE_CLIENT_SECRET=replace-with-your-cashfree-client-secret
# Optional overrides. Point these at the sandbox hosts while testing:
#   CASHFREE_BASE_URL=https://sandbox.cashfree.com
# The browser checkout SDK's mode (sandbox vs production) is DERIVED from this
# one value, so there is no second setting that can disagree with it.
CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_SECUREID_BASE_URL=https://api.cashfree.com/verification

# Local-only escape hatch for payments, the money twin of KYC_DEV_AUTO_VERIFY
# below. With no Cashfree credentials set, createOrder/getOrder/refund throw a
# 503 instead of faking success, because a faked payment is a confirmed booking
# nobody paid for. Set this to true to exercise the booking flow on an empty
# .env. assertConfig REFUSES TO BOOT in production if it is set.
#
# It deliberately does NOT cover webhook signature verification: that fails
# closed with no secret, always. A forged webhook is a free scooter.
PAYMENTS_DEV_AUTO_SUCCEED=false

# Local-only master OTP: this code is accepted for any phone/email OTP as well as
# the real one (a code must still have been requested). Ignored when
# NODE_ENV=production, and production refuses to start with it set.
DEV_OTP_CODE=

# Local-only: with a real WHATSAPP_TOKEN, send real messages only to these
# numbers (comma-separated, e.g. 919876543210); others are logged instead.
# Ignored when NODE_ENV=production.
WHATSAPP_ONLY_TO=

# Local-only escape hatch for driving-licence checks. With no Cashfree
# credentials set, providers/kyc.ts reports SANDBOX_UNAVAILABLE (a 503) instead
# of faking a pass, because a faked pass is an approved driving licence and the
# other five providers' fake successes are harmless by comparison. Set this to
# true to get the old faked VERIFIED back so the booking flow can be exercised
# on an empty .env. assertConfig REFUSES TO BOOT in production if it is set.
KYC_DEV_AUTO_VERIFY=false

# Pepper for the driving-licence number hash. The full number is never stored
# -- only this hash (for spotting one licence used on several accounts) and a
# mask -- so an unpeppered hash would effectively BE the number: DL formats
# carry little entropy and a lookup table is cheap. Required in production
# while ONLINE_LICENCE_CHECK=true.
# Changing it orphans every existing hash, so set it once.
DL_HASH_PEPPER=replace-with-a-long-random-string

# Which row of vehicle_class_licence_rules decides what a licence entitles its
# holder to ride. Bump it to roll out a reviewed mapping without editing the
# old one, so a booking's decision stays reproducible after the rules change.
DL_VERIFICATION_POLICY_VERSION=v1

# Riders verified before the eligibility engine existed have no licence
# category data, no RTO status and sometimes no date of birth, because nothing
# captured them. Judging them by today's rules would make every existing rider
# unbookable overnight, so until this date their missing data is grandfathered
# and the session is flagged for review instead of blocking the booking. An
# expired or suspended legacy licence still fails. UNSET MEANS NO GRACE.
LEGACY_LICENCE_GRACE_UNTIL=2026-12-31

# When neither DigiLocker nor the RTO lookup returns a photograph of the licence
# holder, the customer is asked to upload one of the rider. That photo proves
# nothing about whose licence it is, so the session normally goes to a human
# instead of being approved. Set this to true only if you accept approving a
# rental on an unverified photograph.
ALLOW_LOW_ASSURANCE_VERIFICATION=false

# How long a rider's licence photograph is kept after their last completed
# rental (or after it was taken, if they never rented). The consent text
# promises deletion, and lib/verificationRetention.ts is what keeps that
# promise. The masked licence number and its hash are NOT deleted: they are the
# audit record of a decision, and they identify nobody on their own.
VERIFICATION_PHOTO_RETENTION_DAYS=90

# --- Merchant payouts (Cashfree Payouts V2) ---------------------------------
# A SEPARATE Cashfree product from the gateway above: its own activation, its
# own credential pair from the Payouts dashboard, its own base path. The code
# deliberately does NOT fall back to the gateway credentials -- if Payouts needs
# its own pair and we silently reused the other, every transfer would 401 with a
# message that points nowhere.
#
# Since migration 0021 merchants are paid from their shop wallet: these are used
# only when an admin pays a withdrawal through Cashfree (lib/wallet.ts). Without
# them, withdrawals are paid offline (bank transfer / UPI / cash) and recorded
# with a reference. With PAYMENTS_DEV_AUTO_SUCCEED above, transfers are faked locally.
#
# Cashfree requires either IP whitelisting or x-cf-signature public-key auth on
# Payouts. NEITHER IS IMPLEMENTED -- see docs/payments-checklist.md before going
# live, or every transfer will be refused.
CASHFREE_PAYOUT_CLIENT_ID=replace-with-your-cashfree-payouts-client-id
CASHFREE_PAYOUT_CLIENT_SECRET=replace-with-your-cashfree-payouts-client-secret
# Point at the sandbox while testing: https://sandbox.cashfree.com/payout
CASHFREE_PAYOUT_BASE_URL=https://api.cashfree.com/payout

# --- Vehicle tracking (flespi) ----------------------------------------------
# Read-only passthrough; no telemetry is stored.
FLESPI_TOKEN=replace-with-your-flespi-token
FLESPI_BASE_URL=https://flespi.io

# --- Shop wallet ------------------------------------------------------------
# Every booking credits the shop's wallet (lib/wallet.ts); the merchant asks to
# withdraw and an admin pays it through Cashfree Payouts or offline. The
# smallest withdrawal a merchant can ask for, in paise. Default 50000 (₹500).
MIN_WITHDRAWAL_PAISE=50000

# --- Object storage (Cloudflare R2, S3-compatible) --------------------------
# Presigned upload/download only -- the server never carries the bytes.
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET=retromobi

# Enable the original-licence-at-pickup fallback after reviewing the policy.
PICKUP_LICENCE_FALLBACK=false

# Beta default (unset/false): no online licence check. Customers tick two
# licence statements at checkout and the shop checks the original at pickup.
# "true" restores the online Cashfree Secure ID / DigiLocker gate.
ONLINE_LICENCE_CHECK=false
