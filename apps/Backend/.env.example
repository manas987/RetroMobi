# Copy to .env and fill in. Values here are placeholders, never real credentials.
#
# Vars marked REQUIRED are checked by src/lib/config.ts and the server refuses to
# start without them -- they are the ones whose absence produces silently wrong
# money or documents rather than a loud error.
#
# Every third-party provider (Twilio, Resend, Cashfree, flespi, R2) falls back to
# a console.log + a fake-but-well-typed success response when its vars below are
# left blank -- look for "[dev-fallback]" in server logs. This means the WHOLE
# app (signup, booking, payment, payout, KYC, tracking, uploads) runs end-to-end
# locally with zero vendor credentials, which is the point: fill in a provider's
# vars and it switches to the real API with no code change, nothing else to flip.
#
# envDrift.test.ts fails if the code reads a var that is missing from this file.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://retromobi:retromobi@localhost:5433/retromobi          # REQUIRED
TEST_DATABASE_URL=postgres://retromobi:retromobi@localhost:5433/retromobi_test
AUTH_ACCESS_TOKEN_SECRET=change-me-in-prod                                     # REQUIRED
PORT=3000

# --- Money and tax ----------------------------------------------------------
# Set these with your accountant. The three percentages are REQUIRED: each has a
# code-level fallback that would otherwise price bookings at a rate nobody chose.
# Prices are TAX-INCLUSIVE -- GST is extracted from the listed price, not added.
GST_RATE=18
PLATFORM_FEE_PCT=10
PAYOUT_UPFRONT_PCT=10
# RetroMobi's own GSTIN, printed on every PLATFORM fee invoice. OPTIONAL: leave it
# blank until you are GST-registered and no PLATFORM invoice is issued (same rule as
# an unregistered shop). If you do set it, it must be a real 15-character GSTIN --
# a placeholder will not boot, because a wrong GSTIN on a tax invoice is worse than
# a blank one.
PLATFORM_GSTIN=

# --- Google sign-in ---------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-your-twilio-sender-number

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_ADDRESS=noreply@example.com

# --- Payments and KYC (Cashfree) --------------------------------------------
# One vendor for both: PG Orders for payments, Secure ID for DL + DigiLocker.
CASHFREE_CLIENT_ID=replace-with-your-cashfree-client-id
CASHFREE_CLIENT_SECRET=replace-with-your-cashfree-client-secret
# Optional overrides. Point these at the sandbox hosts while testing.
CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_SECUREID_BASE_URL=https://api.cashfree.com/verification

# --- Vehicle tracking (flespi) ----------------------------------------------
# Read-only passthrough; no telemetry is stored.
FLESPI_TOKEN=replace-with-your-flespi-token
FLESPI_BASE_URL=https://flespi.io

# --- Object storage (Cloudflare R2, S3-compatible) --------------------------
# Presigned upload/download only -- the server never carries the bytes.
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET=retromobi
