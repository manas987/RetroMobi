# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app, and they
# are readable by anyone with the app file: never put a secret here.

# Where the backend (apps/Backend, port 3000) is reachable FROM THE PHONE:
#   Android emulator   http://10.0.2.2:3000
#   iOS simulator      http://localhost:3000
#   Real phone         http://<your computer's Wi-Fi IP>:3000   (same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Public Mapbox token (must start with pk.). Empty hides maps.
EXPO_PUBLIC_MAPBOX_TOKEN=
# The same Google web client id the backend checks. Empty hides the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
